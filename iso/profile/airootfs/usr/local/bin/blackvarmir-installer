#!/usr/bin/env bash
# Заглушка установника. Графічний установник (екрани з дошки «Етап 8») додається
# наступними змінами; поки що показує, як поставити систему вручну.
exec kitty --title "BlackVarmir installer" bash -c '
cat <<TXT
BlackVarmir Arch live session

The graphical installer is not ready yet. To install by hand:

  1. Partition and mount the target at /mnt (leave other systems untouched).
  2. pacstrap -K /mnt base linux linux-firmware
  3. arch-chroot /mnt, then run /opt/blackvarmir-dots/install.sh

TXT
exec bash'
