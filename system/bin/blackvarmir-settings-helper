#!/usr/bin/env bash
# Помічник застосунку «Налаштування» для дій, які потребують прав root.
# Запускається лише через pkexec (система попросить пароль):
#   pkexec /usr/local/bin/blackvarmir-settings-helper <дія> [аргументи]
#
# Дії:
#   locale   <мова> <формати>   uk_UA.UTF-8 en_US.UTF-8 — увімкнути в locale.gen, згенерувати, застосувати
#   timezone <зона>             Europe/Kyiv
#   ntp      <true|false>
#   lid      <suspend|lock|ignore>
#   avatar   <файл>             аватар для екрана входу (SDDM)
#   realname <ім'я>
#   snapshot-restore <номер>    відновити систему до знімка snapper (поточна зберігається знімком)
#   snapshot-keep    <5|10|20>  скільки автоматичних знімків тримати
#   snapshot-daily   <on|off>   щоденний знімок (таймлайн snapper)
#   snapshot-updates <on|off>   знімок перед кожною транзакцією pacman (snap-pac)
#
# Кожен аргумент перевіряється за суворим шаблоном — довільних команд скрипт не виконує.

set -euo pipefail

die() { echo "blackvarmir-settings-helper: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "запускай через pkexec"
[[ -n "${PKEXEC_UID:-}" ]] || die "запускай через pkexec"
USER_NAME="$(id -nu "$PKEXEC_UID")"

valid_locale() { [[ "$1" =~ ^[a-z]{2,3}_[A-Z]{2}\.UTF-8$ ]]; }

enable_locale() {
    local loc="$1"
    grep -qE "^${loc//./\\.} UTF-8" /etc/locale.gen && return 0
    if grep -qE "^#\s*${loc//./\\.} UTF-8" /etc/locale.gen; then
        sed -i -E "s/^#\s*(${loc//./\\.} UTF-8)/\1/" /etc/locale.gen
    else
        echo "$loc UTF-8" >> /etc/locale.gen
    fi
    return 1
}

# Відновлення: поточний корінь стає знімком «Перед відновленням», а знімок N —
# новим коренем (той самий підтом, що вказаний у /etc/fstab, тож завантажувач не змінюється).
# Працює і зі звичайної системи, і після завантаження зі знімка (grub-btrfs).
restore_snapshot() {
    local num="$1" dev snapfs rootvol ts
    [[ "$(findmnt -no FSTYPE /.snapshots 2>/dev/null)" == "btrfs" ]] || die "знімки snapper не налаштовано"
    dev="$(findmnt -no SOURCE /.snapshots | sed 's/\[.*//')"
    snapfs="$(findmnt -no FSROOT /.snapshots)"             # /@.snapshots або /@snapshots
    rootvol="$(awk '$2 == "/" && $3 == "btrfs" { n = split($4, o, ","); for (i = 1; i <= n; i++) if (o[i] ~ /^subvol=/) { sub(/^subvol=\/?/, "", o[i]); print o[i] } }' /etc/fstab)"
    [[ -n "$rootvol" && "$rootvol" =~ ^[A-Za-z0-9@._-]+$ ]] || die "не знайдено підтом кореня в /etc/fstab"
    TOP="$(mktemp -d)"
    mount -o subvolid=5 "$dev" "$TOP"
    trap 'umount "$TOP" 2>/dev/null; rmdir "$TOP" 2>/dev/null' EXIT
    [[ -d "$TOP${snapfs}/$num/snapshot" ]] || die "знімка $num немає"
    # Поточний стан — знімком, щоб відновлення можна було скасувати так само
    local title before
    title="Перед відновленням до #$num"
    [[ "$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null)" == uk* ]] || title="Before restoring #$num"
    if before=$(snapper -c root create -t single -c "" --print-number -d "$title" --userdata "important=yes,kind=restore,title=$title"); then
        snapper -c root modify -d "#$before · $(date '+%Y-%m-%d %H:%M') · $title" "$before" || true
    fi
    ts="$(date +%Y-%m-%d_%H-%M-%S)"
    mv "$TOP/$rootvol" "$TOP/$rootvol-old-$ts"
    btrfs subvolume snapshot "$TOP${snapfs}/$num/snapshot" "$TOP/$rootvol"
    # Старий корінь (вже збережений знімком вище) прибере blackvarmir-restore-cleanup після перезавантаження
    echo "$rootvol-old-$ts" >> "$TOP/.blackvarmir-restore-cleanup"
}

action="${1:-}"
shift || true

case "$action" in
    locale)
        lang="${1:-}"; formats="${2:-$lang}"
        valid_locale "$lang" && valid_locale "$formats" || die "невірна локаль"
        regen=0
        enable_locale "$lang" || regen=1
        enable_locale "$formats" || regen=1
        if (( regen )); then locale-gen; fi
        localectl set-locale "LANG=$lang" \
            "LC_TIME=$formats" "LC_NUMERIC=$formats" "LC_MONETARY=$formats" \
            "LC_PAPER=$formats" "LC_MEASUREMENT=$formats"
        ;;
    timezone)
        tz="${1:-}"
        [[ "$tz" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f "/usr/share/zoneinfo/$tz" ]] || die "невірний часовий пояс"
        timedatectl set-timezone "$tz"
        ;;
    ntp)
        [[ "${1:-}" == "true" || "${1:-}" == "false" ]] || die "очікується true або false"
        timedatectl set-ntp "$1"
        ;;
    lid)
        case "${1:-}" in suspend|lock|ignore) ;; *) die "невірна дія для кришки" ;; esac
        install -Dm644 /dev/stdin /etc/systemd/logind.conf.d/10-blackvarmir.conf <<EOF
# Згенеровано «Налаштуваннями» BlackVarmir
[Login]
HandleLidSwitch=$1
HandleLidSwitchExternalPower=$1
EOF
        systemctl kill -s HUP systemd-logind
        ;;
    avatar)
        src="${1:-}"
        [[ -f "$src" ]] || die "файл не знайдено"
        # Лише файли самого користувача
        [[ "$(stat -c %u "$src")" == "$PKEXEC_UID" ]] || die "файл належить іншому користувачу"
        install -Dm644 "$src" "/usr/share/sddm/faces/$USER_NAME.face.icon"
        ;;
    realname)
        name="${1:-}"
        [[ -n "$name" && ${#name} -le 64 && "$name" != *[:,=$'\n']* ]] || die "невірне ім'я"
        usermod -c "$name" "$USER_NAME"
        ;;
    snapshot-restore)
        num="${1:-}"
        [[ "$num" =~ ^[0-9]+$ && "$num" -gt 0 ]] || die "невірний номер знімка"
        restore_snapshot "$num"
        ;;
    snapshot-keep)
        case "${1:-}" in 5|10|20) ;; *) die "очікується 5, 10 або 20" ;; esac
        snapper -c root set-config "NUMBER_LIMIT=$1" "NUMBER_LIMIT_IMPORTANT=$1"
        ;;
    snapshot-daily)
        case "${1:-}" in
            on)  snapper -c root set-config TIMELINE_CREATE=yes TIMELINE_LIMIT_HOURLY=0 TIMELINE_LIMIT_DAILY=7 \
                     TIMELINE_LIMIT_WEEKLY=0 TIMELINE_LIMIT_MONTHLY=0 TIMELINE_LIMIT_YEARLY=0
                 systemctl enable --now snapper-timeline.timer ;;
            off) snapper -c root set-config TIMELINE_CREATE=no ;;
            *) die "очікується on або off" ;;
        esac
        ;;
    snapshot-updates)
        case "${1:-}" in on) v=True ;; off) v=False ;; *) die "очікується on або off" ;; esac
        printf '# Згенеровано «Налаштуваннями» BlackVarmir\n[root]\nsnapshot = %s\n' "$v" > /etc/snap-pac.ini
        ;;
    *)
        die "невідома дія: $action"
        ;;
esac
